PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Brevo SMTP for email OTP delivery. Without these, OTPs are logged to the
# server console so local development keeps working. Get SMTP key under
# Brevo dashboard → SMTP & API → SMTP.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-login
BREVO_SMTP_PASS=your-brevo-smtp-key
# Sender shown on the emails (should be a verified sender in Brevo)
BREVO_FROM_NAME=Billing App
BREVO_FROM_EMAIL=billing@yourdomain.com

# Optional overrides — defaults to ./data/billing.db inside the backend folder
# DATA_DIR=./data
# DB_PATH=./data/billing.db
# Production (Turso/libSQL): uncomment and set these to use a hosted database.
# When set, TURSO_DATABASE_URL wins over DATA_DIR/DB_PATH.
# TURSO_DATABASE_URL=libsql://my-db-org.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...  (create with: turso db tokens create my-db)
